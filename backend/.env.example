# Flask / JWT secrets — REQUIRED in production (app refuses to start without them).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Environment: "development" (default) or "production"
FLASK_ENV=development

# Database — omit to use local SQLite (backend/instance/restaurant.db).
# Production (NeonDB): postgresql://user:password@host/dbname
# DATABASE_URL=postgresql://user:password@host/dbname

# Email notifications (optional — "Ready" order emails are skipped if unset).
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=you@example.com
